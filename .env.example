# Copy to .env.local for local development, and paste the same values into
# Vercel under Settings → Environment Variables for the deployed app.

# --- Sign-in ---------------------------------------------------------------

# Signs the session cookie. Any 32+ random characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# The shared code your team types to get in. Change it after each exhibition
# if the link has been passed around.
TEAM_PASSCODE=

# Comma-separated names shown on the "who are you?" picker. Whoever is picked
# is recorded against every lead they capture and appears in the export.
# Leave blank to get a free-text name box instead.
TEAM_MEMBERS=Shas,Alice,Bob

# --- Storage (Supabase) ----------------------------------------------------

# https://<project-id>.supabase.co
# Your project ID is the code in your Supabase dashboard's web address, the bit
# after /project/ — so .../dashboard/project/abcdefghijklmnop/... gives you
# https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase → Project Settings → API Keys. Take the Secret key (sb_secret_…),
# or on older projects the legacy service_role key. NOT the publishable or
# anon one. Both work; prefer the Secret key, because it can be revoked on its
# own if it ever leaks.
#
# This is a master key for the database. Keep it out of chats and commits — it
# is only ever used server-side and never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Card reading (Anthropic) ----------------------------------------------

# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5, which is the right balance of
# accuracy and cost for reading a card.
# ANTHROPIC_MODEL=claude-sonnet-5
